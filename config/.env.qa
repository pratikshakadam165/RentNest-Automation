# Settings for the 'qa' environment (TEST_ENV=qa, the default). Nothing here is a real secret:
# the accounts are the demo users and the webhook secrets are the public sandbox values from API.md.
# For another environment, add config/.env.<name> and run with TEST_ENV=<name>.

# URL of the running RentNest app (start it with `npm start` in the app folder)
BASE_URL=http://localhost:4000

# Demo accounts (after POST /api/dev/reset)
LANDLORD_EMAIL=landlord@rentnest.test
LANDLORD_PASSWORD=Landlord@123
LANDLORD2_EMAIL=landlord2@rentnest.test
LANDLORD2_PASSWORD=Landlord@123
TENANT_A_EMAIL=tenant.a@rentnest.test
TENANT_A_PASSWORD=Tenant@123

# Password for the new tenants the tests sign up
NEW_TENANT_PASSWORD=Secret123

# Test card and bank sandbox login
TEST_CARD=4242 4242 4242 4242
BANK_USER=good_income
BANK_PASSWORD=Everyday

# Webhook signing secrets (sandbox values from API.md)
VERIFYNOW_SECRET=whsec_verifynow_sandbox_7Q2x
BANKBRIDGE_SECRET=whsec_bankbridge_sandbox_K9m4
